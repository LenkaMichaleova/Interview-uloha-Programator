    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.16.0",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.5.3",
